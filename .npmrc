# ──────────────────────────────────────────────────
# Protecciones de seguridad para npm
# ──────────────────────────────────────────────────

# Bloquea la ejecución de scripts de pre/post install
# Esto previene que paquetes maliciosos ejecuten código
# al momento de instalarse (vector de ataque más común)
ignore-scripts=true

# Solo instala desde el registro oficial de npm
registry=https://registry.npmjs.org/

# Requiere versiones exactas al instalar (evita inyección de rangos)
save-exact=true

# Activa auditoría automática en cada install
audit=true

# Nivel mínimo de auditoría que bloquea la instalación
audit-level=high
